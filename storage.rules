rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return isSignedIn() && (
        request.auth.token.role == 'superadmin' ||
        request.auth.token.email == 'superadmin@setara.co.id'
      );
    }

    function isAssignedToHotel(hotelCode) {
      return isSignedIn() && (
        request.auth.token.hotelCode == hotelCode ||
        (request.auth.token.allowedOutlets != null && hotelCode in request.auth.token.allowedOutlets)
      );
    }

    // Strictly safe raster image types only (SVG excluded to prevent Stored XSS)
    function isSafeImage() {
      return request.resource != null &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }

    function isValidFileSize() {
      return request.resource != null &&
        request.resource.size < 5 * 1024 * 1024; // Max 5 MB
    }

    // Guest Self-Order transfer proofs (Controlled size & safe raster image only, no overwrite/delete)
    match /hotels/{hotelCode}/transfer_proofs/{fileName} {
      allow read: if true;
      allow create: if isSafeImage() && request.resource.size < 3 * 1024 * 1024;
      allow update, delete: if isSuperadmin() || isAssignedToHotel(hotelCode);
    }

    // Hotel-scoped assets (Gallery, logo, products, promotions)
    match /hotels/{hotelCode}/{allPaths=**} {
      allow read: if true;
      allow write: if (isSuperadmin() || isAssignedToHotel(hotelCode)) && isSafeImage() && isValidFileSize();
    }

    // Tenant-scoped leave attachments (Safe raster images or PDF up to 5MB, no overwrite/delete by unauthenticated callers)
    match /attachments/{hotelCode}/{staffId}/{fileName} {
      allow read: if true;
      allow create: if (isSafeImage() || (request.resource != null && request.resource.contentType == 'application/pdf')) && isValidFileSize();
      allow update, delete: if isSuperadmin() || isAssignedToHotel(hotelCode);
    }

    // Tenant-scoped attachments
    match /attachments/{hotelCode}/{allPaths=**} {
      allow read: if isSuperadmin() || isAssignedToHotel(hotelCode);
      allow write: if (isSuperadmin() || isAssignedToHotel(hotelCode)) && isSafeImage() && isValidFileSize();
    }

    // Legacy shared paths (Authenticated users only, safe images only)
    match /{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSafeImage() && isValidFileSize();
    }
  }
}
